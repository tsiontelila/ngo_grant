<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_subgrant_amendment" model="ir.sequence">
            <field name="name">Subgrant Amendment Number</field>
            <field name="code">ngo.subgrant.amendment</field>
            <field name="prefix">SUBAMD-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_subgrant_disbursement" model="ir.sequence">
            <field name="name">Subgrant Disbursement Reference</field>
            <field name="code">ngo.subgrant.disbursement</field>
            <field name="prefix">SUBDISB-</field>
            <field name="padding">5</field>
        </record>
        
        <!-- Grant Sequence -->
        <record id="seq_grant" model="ir.sequence">
            <field name="name">Grant Reference</field>
            <field name="code">ngo.grant</field>
            <field name="prefix">GRANT-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Donor Sequence -->
        <record id="seq_donor" model="ir.sequence">
            <field name="name">Donor Code</field>
            <field name="code">ngo.grant.donor</field>
            <field name="prefix">DONOR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Amendment Sequence -->
        <record id="seq_amendment" model="ir.sequence">
            <field name="name">Amendment Number</field>
            <field name="code">ngo.grant.amendment</field>
            <field name="prefix">AMD-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Disbursement Sequence -->
        <record id="seq_disbursement" model="ir.sequence">
            <field name="name">Disbursement Reference</field>
            <field name="code">ngo.grant.disbursement</field>
            <field name="prefix">DISB-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
    </data>
</odoo>
