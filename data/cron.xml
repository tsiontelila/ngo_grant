<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job for checking grant expiry -->
        <record id="cron_check_grant_expiry" model="ir.cron">
            <field name="name">Check Grant Expiry</field>
            <field name="model_id" ref="model_ngo_grant"/>
            <field name="state">code</field>
            <field name="code">model.check_grant_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron job for sending compliance reminders -->
        <record id="cron_send_compliance_reminders" model="ir.cron">
            <field name="name">Send Compliance Reminders</field>
            <field name="model_id" ref="model_ngo_grant_compliance"/>
            <field name="state">code</field>
            <field name="code">model.env['ngo.grant.compliance.service'].send_compliance_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron job for sending report reminders -->
        <record id="cron_send_report_reminders" model="ir.cron">
            <field name="name">Send Report Reminders</field>
            <field name="model_id" ref="model_ngo_grant_reporting_schedule"/>
            <field name="state">code</field>
            <field name="code">model.env['ngo.grant.reporting.service'].send_report_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron job for updating overdue items -->
        <record id="cron_update_overdue_items" model="ir.cron">
            <field name="name">Update Overdue Items</field>
            <field name="model_id" ref="model_ngo_grant"/>
            <field name="state">code</field>
            <field name="code">model.update_overdue_items()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron job for checking document expiry -->
        <record id="cron_check_document_expiry" model="ir.cron">
            <field name="name">Check Document Expiry</field>
            <field name="model_id" ref="model_ngo_grant_document"/>
            <field name="state">code</field>
            <field name="code">model.check_document_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <!-- Cron job for checking budget overruns -->
        <record id="cron_check_budget_overruns" model="ir.cron">
            <field name="name">Check Grant Budget Overruns</field>
            <field name="model_id" ref="model_ngo_grant_budget_period"/>
            <field name="state">code</field>
            <field name="code">model.check_budget_overruns()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron job for unspent balance reminders (weekly) -->
        <record id="cron_unspent_balance_reminder" model="ir.cron">
            <field name="name">Grant Unspent Balance Reminder</field>
            <field name="model_id" ref="model_ngo_grant"/>
            <field name="state">code</field>
            <field name="code">model.send_unspent_balance_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>

