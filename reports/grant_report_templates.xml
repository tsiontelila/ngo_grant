<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="grant_summary_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Grant Summary Report: <span t-field="o.grant_number"/></h2>
                        <hr/>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>Grant Name:</strong></td>
                                <td><span t-field="o.grant_name"/></td>
                                <td><strong>Short Name:</strong></td>
                                <td><span t-field="o.short_name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Restriction Type:</strong></td>
                                <td><span t-field="o.restriction_type"/></td>
                                <td><strong>Status:</strong></td>
                                <td><span t-field="o.state"/></td>
                            </tr>
                            <tr>
                                <td><strong>Start Date:</strong></td>
                                <td><span t-field="o.start_date"/></td>
                                <td><strong>End Date:</strong></td>
                                <td><span t-field="o.end_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Approved Amount:</strong></td>
                                <td><span t-field="o.approved_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><strong>Disbursed Amount:</strong></td>
                                <td><span t-field="o.disbursed_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </table>

                        <h4 class="mt-4">Donor Allocations</h4>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Donor</th>
                                    <th>Lead Donor</th>
                                    <th>Contribution Amount</th>
                                    <th>Contribution (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.donor_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.donor_id.name"/></td>
                                        <td><span t-field="line.lead_donor"/></td>
                                        <td><span t-field="line.contribution_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td><span t-field="line.contribution_percentage"/>%</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Funded Projects</h4>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Project</th>
                                    <th>Allocation Amount</th>
                                    <th>Primary Funding</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.project_ids" t-as="proj">
                                    <tr>
                                        <td><span t-field="proj.project_id.name"/></td>
                                        <td><span t-field="proj.allocation_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td><span t-field="proj.is_primary_funding"/></td>
                                        <td><span t-field="proj.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="o.budget_period_ids">
                            <h4 class="mt-4">Fiscal Period Sub-Budgets</h4>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Period</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Allocated Budget</th>
                                        <th>Spent Amount</th>
                                        <th>Overrun Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.budget_period_ids" t-as="b">
                                        <tr>
                                            <td><span t-field="b.name"/></td>
                                            <td><span t-field="b.start_date"/></td>
                                            <td><span t-field="b.end_date"/></td>
                                            <td><span t-field="b.allocated_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            <td><span t-field="b.spent_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            <td><span t-field="b.overrun_action"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="o.milestone_ids">
                            <h4 class="mt-4">Conditions &amp; Milestones</h4>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Milestone Name</th>
                                        <th>Target Date</th>
                                        <th>Release Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.milestone_ids" t-as="m">
                                        <tr>
                                            <td><span t-field="m.name"/></td>
                                            <td><span t-field="m.target_date"/></td>
                                            <td><span t-field="m.release_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            <td><span t-field="m.state"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
