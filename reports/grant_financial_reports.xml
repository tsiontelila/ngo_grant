<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="grant_income_statement_template">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout">
            <div class="page">
                <h2>Grant Summary</h2><h4><span t-field="o.grant_number"/> — <span t-field="o.grant_name"/></h4>
                <p><span t-field="o.start_date"/> to <span t-field="o.end_date"/> | Status: <span t-field="o.state"/></p>
                <table class="table table-sm"><tr><td>Approved Amount</td><td><span t-field="o.approved_amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr><tr><td>Disbursed Amount</td><td><span t-field="o.disbursed_amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr><tr><td>Remaining Amount</td><td><span t-field="o.remaining_amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr></table>
                <t t-if="o.budget_period_ids"><h4>Fiscal Period Budgets</h4><table class="table table-sm"><tr><th>Period</th><th>Allocated</th><th>Spent</th><th>Remaining</th></tr><tr t-foreach="o.budget_period_ids" t-as="b"><td><span t-field="b.name"/></td><td><span t-field="b.allocated_amount"/></td><td><span t-field="b.spent_amount"/></td><td><span t-field="b.remaining_amount"/></td></tr></table></t>
            </div>
        </t></t></t>
    </template>
    <template id="grant_balance_sheet_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Grant Fund Position</h2><h4><span t-field="o.grant_number"/> — <span t-field="o.grant_name"/></h4><p>Approved: <span t-field="o.approved_amount"/> | Disbursed: <span t-field="o.disbursed_amount"/> | Remaining: <span t-field="o.remaining_amount"/></p></div></t></t></t></template>
    <template id="grant_cash_flow_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Grant Cash Flow</h2><h4><span t-field="o.grant_number"/> — <span t-field="o.grant_name"/></h4><table class="table table-sm"><tr><th>Reference</th><th>Date</th><th>Type</th><th>Amount</th><th>Status</th></tr><tr t-foreach="o.disbursement_ids" t-as="d"><td><span t-field="d.name"/></td><td><span t-field="d.disbursement_date"/></td><td><span t-field="d.disbursement_type_id.name"/></td><td><span t-field="d.amount"/></td><td><span t-field="d.state"/></td></tr></table></div></t></t></t></template>
    <template id="grant_fund_analysis_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Grant Fund Analysis</h2><h4><span t-field="o.grant_number"/> — <span t-field="o.grant_name"/></h4><p>Approved: <span t-field="o.approved_amount"/> | Donor Contributions: <span t-field="o.total_contributed_amount"/> | Disbursed: <span t-field="o.disbursed_amount"/> | Subgrant Allocations: <span t-field="o.subgrant_amount"/></p><t t-if="o.subgrant_ids"><h4>Subgrants</h4><table class="table table-sm"><tr><th>Subgrant</th><th>Approved</th><th>Disbursed</th><th>Remaining</th><th>Status</th></tr><tr t-foreach="o.subgrant_ids" t-as="sg"><td><span t-field="sg.grant_number"/> — <span t-field="sg.grant_name"/></td><td><span t-field="sg.approved_amount"/></td><td><span t-field="sg.disbursed_amount"/></td><td><span t-field="sg.remaining_amount"/></td><td><span t-field="sg.state"/></td></tr></table></t></div></t></t></t></template>
    <template id="grant_donor_statement_template"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Grant Donor Statement</h2><h4><span t-field="o.grant_number"/> — <span t-field="o.grant_name"/></h4><table class="table table-sm"><tr><th>Donor</th><th>Reference</th><th>Contribution</th><th>Share</th></tr><tr t-foreach="o.donor_line_ids" t-as="d"><td><span t-field="d.donor_id.name"/></td><td><span t-field="d.donor_reference"/></td><td><span t-field="d.contribution_amount"/></td><td><span t-field="d.contribution_percentage"/></td></tr></table></div></t></t></t></template>
</odoo>
