<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Grant Report Action -->
    <record id="report_grant_summary" model="ir.actions.report">
        <field name="name">Grant Summary Report</field>
        <field name="model">ngo.grant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ngo_grant.grant_summary_report_template</field>
        <field name="report_file">ngo_grant.grant_summary_report_template</field>
        <field name="print_report_name">'Grant Summary - %s' % (object.grant_number)</field>
        <field name="binding_model_id" ref="model_ngo_grant"/>
        <field name="binding_type">report</field>
    </record>
    
</odoo>
