<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_grant_export_wizard_form" model="ir.ui.view">
            <field name="name">ngo.grant.export.wizard.form</field>
            <field name="model">ngo.grant.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Export Grant Report">
                    <sheet>
                        <group>
                            <group string="Report Settings">
                                <field name="grant_id" readonly="1"/>
                                <field name="report_type"/>
                                <field name="export_format"/>
                            </group>
                            <group string="Date Filter (optional)">
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <group string="Include Sections">
                            <field name="include_disbursements"/>
                            <field name="include_milestones"/>
                            <field name="include_budget_periods"/>
                            <field name="include_audit_trail"/>
                        </group>

                        <!-- Download area (shown after export) -->
                        <group invisible="not export_file" string="Download">
                            <field name="export_file" filename="export_filename" widget="binary"/>
                            <field name="export_filename" invisible="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_export" string="Export / Download" type="object" class="btn-primary"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_grant_export_wizard" model="ir.actions.act_window">
            <field name="name">Export Grant Report</field>
            <field name="res_model">ngo.grant.export.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_grant_id': active_id}</field>
        </record>

    </data>
</odoo>
