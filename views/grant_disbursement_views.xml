<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Disbursement List View -->
        <record id="view_disbursement_tree" model="ir.ui.view">
            <field name="name">ngo.grant.disbursement.tree</field>
            <field name="model">ngo.grant.disbursement</field>
            <field name="arch" type="xml">
                <list string="Disbursements" decoration-success="state == 'processed'"
                      decoration-warning="state in ['submitted','level1_approved']"
                      decoration-danger="state in ['rejected','cancelled']">
                    <field name="name"/>
                    <field name="grant_id"/>
                    <field name="amount"/>
                    <field name="currency_id"/>
                    <field name="disbursement_date"/>
                    <field name="disbursement_type_id"/>
                    <field name="state" widget="badge"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Disbursement Form View -->
        <record id="view_disbursement_form" model="ir.ui.view">
            <field name="name">ngo.grant.disbursement.form</field>
            <field name="model">ngo.grant.disbursement</field>
            <field name="arch" type="xml">
                <form string="Disbursement">
                    <header>
                        <button name="action_submit" string="Submit for Approval" type="object"
                                invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_process" string="Process Disbursement" type="object"
                                invisible="state != 'approved'" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state not in ['draft','submitted','level1_approved','approved']"
                                class="btn-secondary"/>
                        <button name="action_draft" string="Reset to Draft" type="object"
                                invisible="state in ['draft','processed']"
                                class="btn-secondary"/>
                        <button name="action_draft" string="Reset Disbursement" type="object"
                                invisible="state != 'processed'" class="btn-warning"
                                confirm="Reset this processed disbursement to draft?"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,level1_approved,approved,processed"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <group>
                            <group string="Disbursement Details">
                                <field name="grant_id"/>
                                <field name="disbursement_type_id" required="1" readonly="state != 'draft'"/>
                                <field name="disbursement_date"/>
                                <field name="payment_reference"/>
                            </group>
                            <group string="Amount">
                                <field name="amount"/>
                                <field name="currency_id" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <field name="description" placeholder="Description of this disbursement..."/>
                        </group>


                        <notebook>
                            <page string="Approval Chain">
                                <field name="approval_line_ids" readonly="1">
                                    <list create="0" edit="0" delete="0">
                                        <field name="can_approve" column_invisible="1"/>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="approver_id"/>
                                        <field name="group_id"/>
                                        <field name="state" widget="badge"/>
                                        <field name="action_user_id"/>
                                        <field name="action_date"/>
                                        <button name="action_approve_step" string="Approve" type="object"
                                                class="btn-primary" invisible="not can_approve"/>
                                        <button name="action_reject_step" string="Reject" type="object"
                                                class="btn-danger" invisible="not can_approve"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Internal notes..."/>
                            </page>

                            <page string="Settings">
                                <group>
                                    <field name="active"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Disbursement Action -->
        <record id="action_disbursement" model="ir.actions.act_window">
            <field name="name">Grant Disbursements</field>
            <field name="res_model">ngo.grant.disbursement</field>
            <field name="view_mode">list,kanban,form,pivot,graph</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first disbursement to track grant funding.
                </p>
            </field>
        </record>

        <!-- Disbursement Menu -->
        <menuitem id="menu_disbursement" name="Disbursements" parent="menu_grant_management" action="action_disbursement" sequence="40" groups="group_ngo_director,group_ngo_manager,group_ngo_grant_officer,group_ngo_approver,group_ngo_user,group_ngo_grant_read"/>

    </data>
</odoo>
