<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disbursement_type_list" model="ir.ui.view">
        <field name="name">ngo.grant.disbursement.type.list</field>
        <field name="model">ngo.grant.disbursement.type</field>
        <field name="arch" type="xml">
            <list string="Disbursement Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_disbursement_type_form" model="ir.ui.view">
        <field name="name">ngo.grant.disbursement.type.form</field>
        <field name="model">ngo.grant.disbursement.type</field>
        <field name="arch" type="xml">
            <form string="Disbursement Type">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Approval Chain">
                            <field name="approval_step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_id"/>
                                    <field name="group_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description"><field name="description"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_disbursement_type" model="ir.actions.act_window">
        <field name="name">Disbursement Types</field>
        <field name="res_model">ngo.grant.disbursement.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_grant_configuration" name="Configuration"
              parent="ngo_grant.menu_grant_root" sequence="90"
              groups="ngo_grant.group_ngo_manager,ngo_grant.group_ngo_grant_officer"/>
    <menuitem id="menu_disbursement_type" name="Disbursement Types"
              parent="menu_grant_configuration" action="action_disbursement_type"
              sequence="10" groups="ngo_grant.group_ngo_manager,ngo_grant.group_ngo_grant_officer"/>
</odoo>
