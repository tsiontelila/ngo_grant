<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Grant Project List View -->
        <record id="view_grant_project_tree" model="ir.ui.view">
            <field name="name">ngo.grant.project.tree</field>
            <field name="model">ngo.grant.project</field>
            <field name="arch" type="xml">
                <list string="Grant Project Allocations">
                    <field name="grant_id"/>
                    <field name="project_id"/>
                    <field name="allocation_amount"/>
                    <field name="allocation_percentage" widget="percentage" readonly="1"/>
                    <field name="is_primary_funding"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        
        <!-- Grant Project Form View -->
        <record id="view_grant_project_form" model="ir.ui.view">
            <field name="name">ngo.grant.project.form</field>
            <field name="model">ngo.grant.project</field>
            <field name="arch" type="xml">
                <form string="Grant Project Allocation">
                    <header>
                        <button name="action_activate" string="Approve" type="object" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_suspend" string="Suspend" type="object" invisible="state != 'active'" class="btn-secondary"/>
                        <button name="action_complete" string="Complete" type="object" invisible="state not in ['active', 'suspended']" class="btn-secondary"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ['cancelled', 'completed']" groups="ngo_grant.group_ngo_director,base.group_system" class="btn-danger"/>
                        <button name="action_reset_cancelled" string="Reset to Draft" type="object" invisible="state != 'cancelled' or not can_reset_cancelled" class="btn-warning"/>
                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="draft,approved,active,suspended,completed,cancelled"/>
                    </header>
                    
                    <sheet>
                        <field name="can_reset_cancelled" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="grant_id"/>
                                <field name="project_id"/>
                                <field name="is_primary_funding"/>
                                <field name="is_active" readonly="1"/>
                            </group>
                            <group>
                                <field name="allocation_amount"/>
                                <field name="allocation_percentage" widget="percentage" readonly="1"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                        
                        <group>
                            <group>
                                <field name="priority"/>
                                <field name="funding_role"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Timeline">
                                <field name="funding_start_date"/>
                                <field name="funding_end_date"/>
                            </group>
                        </group>
                        
                        <!--
                        <group>
                            <group string="Monitoring">
                                <field name="utilized_amount" readonly="1"/>
                                <field name="remaining_amount" readonly="1"/>
                            </group>
                            <group string="Counts">
                                <field name="budget_count" readonly="1"/>
                                <field name="procurement_count" readonly="1"/>
                                <field name="cash_request_count" readonly="1"/>
                            </group>
                        </group>
                        -->
                        
                        <group>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                    </sheet>
                    
                    <chatter/>
                </form>
            </field>
        </record>
        
        <!-- Grant Project Action -->
        <record id="action_grant_project" model="ir.actions.act_window">
            <field name="name">Grant Project Allocations</field>
            <field name="res_model">ngo.grant.project</field>
            <field name="view_mode">list,kanban,form,pivot,graph</field>
        </record>
        
        <!-- Grant Project Menu -->
        <menuitem id="menu_grant_project" name="Projects" parent="menu_grant_management" action="action_grant_project" sequence="20" groups="group_ngo_director,group_ngo_manager,group_ngo_grant_officer,group_ngo_approver,group_ngo_user,group_ngo_grant_read"/>
        
    </data>
</odoo>
