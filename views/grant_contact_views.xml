<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Contact List View -->
        <record id="view_contact_tree" model="ir.ui.view">
            <field name="name">ngo.grant.contact.tree</field>
            <field name="model">ngo.grant.contact</field>
            <field name="arch" type="xml">
                <list string="Donor Contacts">
                    <field name="donor_id"/>
                    <field name="partner_id"/>
                    <field name="contact_role"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="primary_contact"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <!-- Contact Form View -->
        <record id="view_contact_form" model="ir.ui.view">
            <field name="name">ngo.grant.contact.form</field>
            <field name="model">ngo.grant.contact</field>
            <field name="arch" type="xml">
                <form string="Donor Contact">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="partner_id" placeholder="Contact Person"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="donor_id"/>
                                <field name="contact_role"/>
                                <field name="primary_contact"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="department"/>
                                <field name="position"/>
                            </group>
                        </group>
                        
                        <group>
                            <group>
                                <field name="preferred_language"/>
                                <field name="preferred_channel"/>
                                <field name="timezone"/>
                            </group>
                            <group>
                                <field name="financial_contact"/>
                                <field name="reporting_contact"/>
                                <field name="procurement_contact"/>
                                <field name="compliance_contact"/>
                            </group>
                        </group>
                        
                        <group>
                            <group>
                                <field name="email"/>
                                <field name="phone"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                    </sheet>
                    
                    <chatter/>
                </form>
            </field>
        </record>
        
        <!-- Contact Action -->
        <record id="action_contact" model="ir.actions.act_window">
            <field name="name">Donor Contacts</field>
            <field name="res_model">ngo.grant.contact</field>
            <field name="view_mode">list,kanban,form,pivot,graph</field>
        </record>
        
        <!-- Contact Menu -->
        <menuitem id="menu_contact" name="Donor Contacts" parent="menu_donor_root" action="action_contact" sequence="20" groups="group_ngo_director,group_ngo_manager,group_ngo_grant_officer,group_ngo_approver,group_ngo_user,group_ngo_grant_read"/>
        
    </data>
</odoo>
