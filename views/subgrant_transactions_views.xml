<odoo>
    <data>
        <record id="view_subgrant_amendment_list" model="ir.ui.view">
            <field name="name">ngo.subgrant.amendment.list</field>
            <field name="model">ngo.subgrant.amendment</field>
            <field name="arch" type="xml">
                <list><field name="amendment_number"/><field name="amendment_name"/><field name="subgrant_id"/><field name="amendment_type"/><field name="amount_change"/><field name="amendment_date"/><field name="state"/></list>
            </field>
        </record>
        <record id="view_subgrant_amendment_form" model="ir.ui.view">
            <field name="name">ngo.subgrant.amendment.form</field>
            <field name="model">ngo.subgrant.amendment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="btn-primary"/>
                        <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" class="btn-danger"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'" groups="ngo_grant.group_ngo_director,base.group_system"/>
                        <button name="action_reset_cancelled" string="Reset to Draft" type="object" invisible="state != 'cancelled' or not can_reset_cancelled" class="btn-warning"/>
                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                    </header>
                    <sheet>
                        <field name="can_reset_cancelled" invisible="1"/>
                        <div class="oe_title"><h1><field name="amendment_number" readonly="1"/></h1><h2><field name="amendment_name" readonly="state in ['approved', 'cancelled']"/></h2></div>
                        <group><group><field name="subgrant_id" readonly="state in ['approved', 'cancelled']"/><field name="amendment_type" readonly="state in ['approved', 'cancelled']"/><field name="amendment_date" readonly="state in ['approved', 'cancelled']"/><field name="effective_date" readonly="state in ['approved', 'cancelled']"/></group>
                        <group><field name="amount_change" readonly="state in ['approved', 'cancelled']"/><field name="previous_approved_amount" readonly="1"/><field name="new_approved_amount" readonly="1"/><field name="original_end_date" readonly="state in ['approved', 'cancelled']"/><field name="new_end_date" readonly="state in ['approved', 'cancelled']"/></group></group>
                        <group><field name="description" readonly="state in ['approved', 'cancelled']"/><field name="amendment_reason" readonly="state in ['approved', 'cancelled']"/></group>
                        <group string="Approval" invisible="state != 'approved'"><field name="approved_by"/><field name="approval_date"/></group>
                    </sheet><chatter/>
                </form>
            </field>
        </record>
        <record id="view_subgrant_disbursement_list" model="ir.ui.view">
            <field name="name">ngo.subgrant.disbursement.list</field>
            <field name="model">ngo.subgrant.disbursement</field>
            <field name="arch" type="xml">
                <list><field name="name"/><field name="subgrant_id"/><field name="disbursement_type_id"/><field name="amount"/><field name="currency_id"/><field name="disbursement_date"/><field name="payment_reference"/><field name="state"/></list>
            </field>
        </record>
        <record id="view_subgrant_disbursement_form" model="ir.ui.view">
            <field name="name">ngo.subgrant.disbursement.form</field>
            <field name="model">ngo.subgrant.disbursement</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_process" string="Process" type="object" invisible="state != 'approved'" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'" groups="ngo_grant.group_ngo_director,base.group_system"/>
                        <button name="action_reset_cancelled" string="Reset to Draft" type="object" invisible="state != 'cancelled' or not can_reset_cancelled" class="btn-warning"/>
                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="draft,submitted,approved,processed,rejected,cancelled"/>
                    </header>
                    <sheet>
                        <field name="can_reset_cancelled" invisible="1"/>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group><group><field name="subgrant_id" readonly="state in ['approved', 'processed', 'cancelled']"/><field name="disbursement_type_id" required="1" readonly="state != 'draft'"/><field name="disbursement_date" readonly="state in ['approved', 'processed', 'cancelled']"/><field name="payment_reference" readonly="state in ['approved', 'processed', 'cancelled']"/></group><group><field name="amount" readonly="state in ['approved', 'processed', 'cancelled']"/><field name="currency_id" readonly="1"/></group></group>
                        <field name="description" readonly="state in ['approved', 'processed', 'cancelled']"/>
                        <notebook>
                            <page string="Approval Chain">
                                <field name="approval_line_ids" readonly="1">
                                    <list create="0" edit="0" delete="0">
                                        <field name="can_approve" column_invisible="1"/>
                                        <field name="sequence"/><field name="name"/><field name="approver_id"/><field name="group_id"/>
                                        <field name="state" widget="badge"/><field name="action_user_id"/><field name="action_date"/>
                                        <button name="action_approve_step" string="Approve" type="object" class="btn-primary" invisible="not can_approve"/>
                                        <button name="action_reject_step" string="Reject" type="object" class="btn-danger" invisible="not can_approve"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes"><field name="notes" readonly="state in ['approved', 'processed', 'cancelled']"/></page>
                            <page string="Settings"><field name="active" readonly="state in ['approved', 'processed', 'cancelled']"/></page>
                        </notebook>
                        <group string="Approval" invisible="state not in ['approved', 'processed']"><field name="approved_by"/><field name="approval_date"/></group>
                    </sheet><chatter/>
                </form>
            </field>
        </record>
        <record id="view_subgrant_document_form" model="ir.ui.view">
            <field name="name">ngo.subgrant.document.form</field>
            <field name="model">ngo.subgrant.document</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" groups="ngo_grant.group_ngo_manager" class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" groups="ngo_grant.group_ngo_manager" class="btn-primary"/>
                        <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="ngo_grant.group_ngo_manager" class="btn-danger"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'" groups="ngo_grant.group_ngo_director,base.group_system" class="btn-secondary"/>
                        <button name="action_reset_cancelled" string="Reset to Draft" type="object" invisible="state != 'cancelled' or not can_reset_cancelled" class="btn-warning"/>
                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                    </header>
                    <sheet>
                        <field name="can_reset_cancelled" invisible="1"/>
                        <group><group><field name="name" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/><field name="subgrant_id" readonly="compliance_id or state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/><field name="compliance_id" domain="[('subgrant_id', '=', subgrant_id)]" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/><field name="document_type" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/></group><group><field name="document_date" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/><field name="approved" readonly="1"/><field name="approved_by" readonly="1"/><field name="approval_date" readonly="1"/></group></group>
                        <group><field name="file" filename="file_name" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/><field name="file_name" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/></group>
                        <field name="description" readonly="state in ['approved', 'active', 'archived', 'expired', 'cancelled']"/>
                    </sheet><chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>
