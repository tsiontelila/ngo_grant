<odoo>
    <data>
        <record id="view_subgrant_amendment_list" model="ir.ui.view">
            <field name="name">ngo.subgrant.amendment.list</field>
            <field name="model">ngo.subgrant.amendment</field>
            <field name="arch" type="xml">
                <list><field name="amendment_number"/><field name="amendment_name"/><field name="subgrant_id"/><field name="amendment_type"/><field name="amount_change"/><field name="amendment_date"/><field name="state"/></list>
            </field>
        </record>
        <record id="view_subgrant_amendment_form" model="ir.ui.view">
            <field name="name">ngo.subgrant.amendment.form</field>
            <field name="model">ngo.subgrant.amendment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="btn-primary"/>
                        <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" class="btn-danger"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'submitted']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="amendment_number" readonly="1"/></h1><h2><field name="amendment_name"/></h2></div>
                        <group><group><field name="subgrant_id"/><field name="amendment_type"/><field name="amendment_date"/><field name="effective_date"/></group>
                        <group><field name="amount_change"/><field name="previous_approved_amount" readonly="1"/><field name="new_approved_amount" readonly="1"/><field name="original_end_date"/><field name="new_end_date"/></group></group>
                        <group><field name="description"/><field name="amendment_reason"/></group>
                        <group string="Approval" invisible="state != 'approved'"><field name="approved_by"/><field name="approval_date"/></group>
                    </sheet><chatter/>
                </form>
            </field>
        </record>
        <record id="view_subgrant_disbursement_list" model="ir.ui.view">
            <field name="name">ngo.subgrant.disbursement.list</field>
            <field name="model">ngo.subgrant.disbursement</field>
            <field name="arch" type="xml">
                <list><field name="name"/><field name="subgrant_id"/><field name="amount"/><field name="currency_id"/><field name="disbursement_date"/><field name="payment_reference"/><field name="state"/></list>
            </field>
        </record>
        <record id="view_subgrant_disbursement_form" model="ir.ui.view">
            <field name="name">ngo.subgrant.disbursement.form</field>
            <field name="model">ngo.subgrant.disbursement</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="btn-primary"/>
                        <button name="action_process" string="Process" type="object" invisible="state != 'approved'" class="btn-primary"/>
                        <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" class="btn-danger"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ['processed', 'cancelled']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,processed,rejected,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group><group><field name="subgrant_id"/><field name="disbursement_date"/><field name="payment_reference"/></group><group><field name="amount"/><field name="currency_id" readonly="1"/></group></group>
                        <field name="description"/>
                        <group string="Approval" invisible="state not in ['approved', 'processed']"><field name="approved_by"/><field name="approval_date"/></group>
                    </sheet><chatter/>
                </form>
            </field>
        </record>
        <record id="view_subgrant_document_form" model="ir.ui.view">
            <field name="name">ngo.subgrant.document.form</field>
            <field name="model">ngo.subgrant.document</field>
            <field name="arch" type="xml">
                <form><sheet>
                    <group><group><field name="name"/><field name="subgrant_id"/><field name="document_type"/></group><group><field name="document_date"/></group></group>
                    <group><field name="file" filename="file_name"/><field name="file_name"/></group>
                    <field name="description"/>
                </sheet><chatter/></form>
            </field>
        </record>
    </data>
</odoo>
